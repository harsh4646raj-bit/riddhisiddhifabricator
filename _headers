# Cloudflare Pages Headers Configuration
# Security, Cache Control, and Performance

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.supabase.co; media-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://gpcgbafqifufkasyzjvt.supabase.co https://*.supabase.co https://api.cloudinary.com https://cdn.jsdelivr.net https://esm.sh; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# Cache static assets (images, webp sequences, videos)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/frames/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure dynamic pages are always fresh
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/js/backend-config.js
  Cache-Control: no-cache, no-store, must-revalidate
